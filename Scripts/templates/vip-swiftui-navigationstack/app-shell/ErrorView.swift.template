import SwiftUI

/// Error state: a message and an optional retry action.
///
/// The retry closure redispatches the same load the screen already performs — an
/// error state without a way out of it is a dead end.
public struct ErrorView: View {
    /// The message shown to the user, already localized by the caller.
    private let message: String
    /// Retry action; `nil` hides the button entirely.
    private let retry: (() -> Void)?

    public init(message: String, retry: (() -> Void)? = nil) {
        self.message = message
        self.retry = retry
    }

    public var body: some View {
        VStack(spacing: 12) {
            Text(message)
                .font(ThemeFont.body)
                .multilineTextAlignment(.center)
                .accessibilityLabel(Text(message))
            if let retry {
                Button(L10n.__MODULE_LOWER__.common.retry, action: retry)
            }
        }
        .padding()
    }
}

