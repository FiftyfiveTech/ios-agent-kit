import Foundation
import Observation

// Holds the NavigationPath for the whole app. If the app grows a tab bar, each tab
// gets its OWN Router/NavigationStack instance — never a single shared one (§3.5).
@Observable
public final class Router {
    public var path: [Route] = []

    public init() {}

    public func push(_ route: Route) {
        path.append(route)
    }

    public func pop() {
        guard !path.isEmpty else { return }
        path.removeLast()
    }

    public func popToRoot() {
        path.removeAll()
    }
}
