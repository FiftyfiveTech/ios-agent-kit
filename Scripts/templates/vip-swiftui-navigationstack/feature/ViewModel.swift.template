import Foundation
import Observation
__MODULE_IMPORTS__

/// What this feature's ViewModel asks its Interactor to do.
///
/// Declared here rather than beside the Interactor because a protocol is owned by
/// its consumer.
protocol __FEATURE__BusinessLogic {
    /// Starts a load. Results arrive through `__FEATURE__DisplayLogic`, never as a
    /// return value.
    func load(request: __FEATURE__.Load.Request) async
}

/// Observable state for the __FEATURE__ screen, and the Presenter's display target.
///
/// A reference type by necessity: the Presenter holds its display target weakly,
/// and a SwiftUI `View` is a value type that can't be the target of a weak
/// reference. This holds no formatting and no business logic — only state.
@Observable
final class __FEATURE__ViewModel: __FEATURE__DisplayLogic {
    /// What the screen should currently render.
    enum State {
        /// Nothing requested yet.
        case idle
        /// A load is in flight.
        case loading
        /// A load succeeded, with the items it returned.
        case loaded([__FEATURE__Model])
        /// A load failed, with a message to show the user.
        case error(String)
    }

    /// The current state. The View renders exactly this.
    private(set) var state: State = .idle

    private let interactor: __FEATURE__BusinessLogic

    init(interactor: __FEATURE__BusinessLogic) {
        self.interactor = interactor
    }

    /// Asks the Interactor to load; the result arrives via the display methods below.
    func load() async {
        state = .loading
        await interactor.load(request: __FEATURE__.Load.Request())
    }

    // MARK: - __FEATURE__DisplayLogic

    /// Records a successful load.
    func display(viewState: __FEATURE__.Load.ViewState) {
        state = .loaded(viewState.items)
    }

    /// Records a failure.
    func display(errorMessage: String) {
        state = .error(errorMessage)
    }
}
