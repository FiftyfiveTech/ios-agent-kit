import Foundation
__MODULE_IMPORTS__

// This layer deals only in Foundation types — no SwiftUI, no UIKit, no colours or
// images in its output.
//
// Two display methods rather than one: `load(request:)` is `async` and does not
// throw, so the Interactor catches its own errors and reports them here. Folding
// that into the ViewState would make every success case carry a dead error field.

/// Receives display-ready output for this feature's screen.
protocol __FEATURE__DisplayLogic: AnyObject {
    /// Renders a successful load.
    func display(viewState: __FEATURE__.Load.ViewState)
    /// Renders a failure.
    func display(errorMessage: String)
}

/// Turns this feature's results into display-ready view state.
final class __FEATURE__Presenter: __FEATURE__PresentationLogic {
    /// The display layer, wired up after both objects exist.
    ///
    /// Weak, and it must stay weak: the ViewModel owns the Interactor, which owns
    /// this Presenter, so a strong reference back closes the cycle and leaks the
    /// whole scene.
    weak var displayLogic: __FEATURE__DisplayLogic?

    /// Formats `response` and hands it to the display layer.
    func present(response: __FEATURE__.Load.Response) {
        let viewState = __FEATURE__.Load.ViewState(items: response.items)
        displayLogic?.display(viewState: viewState)
    }

    /// Formats `error` as a user-facing message.
    func present(error: Error) {
        displayLogic?.display(errorMessage: error.localizedDescription)
    }
}
