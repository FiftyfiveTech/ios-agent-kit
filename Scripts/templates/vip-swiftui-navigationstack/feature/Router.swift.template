import Foundation

// This file needs no module imports: it references only `Route` and `Router`,
// which live in the same module as this feature at every tier.
/// The narrow slice of navigation this scene needs.
///
/// Depending on a capability rather than the concrete app-wide `Router` means a
/// test can exercise this scene's routing without building the whole navigation
/// stack. The app-wide `Router` already has a matching method, so it conforms for
/// free below — no second navigation path is introduced.
protocol __FEATURE__Pushing {
    /// Navigates to `route`.
    func push(_ route: Route)
}

extension Router: __FEATURE__Pushing {}

/// Decides where the __FEATURE__ scene goes next.
///
/// It owns navigation *decisions* for one scene, never navigation state — the
/// app-wide `Router` owns that.
struct __FEATURE__Router {
    private let pushing: __FEATURE__Pushing

    init(pushing: __FEATURE__Pushing) {
        self.pushing = pushing
    }

    // TODO(agent): route to the next screen once this feature has one to push.
    // There are no Route cases yet. e.g.:
    //   func showDetail(id: String) {
    //       pushing.push(.__FEATURE_LOWER__Detail)
    //   }
}
