import UIKit
import SwiftUI // bridges the shared SwiftUI-defined ThemeColor tokens (§6) to UIColor below
__MODULE_IMPORTS__

// MVC's whole file lives together deliberately (§3.3) — this is the pattern's
// documented "Massive View Controller" risk made honest rather than hidden
// behind an extra file. Protocol + implementation still split (§8.2) so the
// generated test can fake the network dependency.
protocol __FEATURE__ServiceProtocol {
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model]
}
__IF_PERSISTENCE__

// MVC has no Repository layer, so the Service is what consumes the local store —
// and therefore what declares its protocol (§8.2). This exists only because the
// project answered Q4 with a persistence stack; a `persistence: None` project's
// Service is remote-only and the ViewController is unchanged either way (§3.8).
protocol __FEATURE__LocalStoreProtocol {
    func loadCached__FEATURE__List() async throws -> [__FEATURE__Model]
    func cache__FEATURE__List(_ items: [__FEATURE__Model]) async throws
}
__END_PERSISTENCE__

struct __FEATURE__Service: __FEATURE__ServiceProtocol {
    private let requestBuilder: RequestBuilder
    private let apiClient: APIClient
__IF_PERSISTENCE__
    private let localStore: __FEATURE__LocalStoreProtocol

    init(
        requestBuilder: RequestBuilder,
        apiClient: APIClient,
        localStore: __FEATURE__LocalStoreProtocol
    ) {
        self.requestBuilder = requestBuilder
        self.apiClient = apiClient
        self.localStore = localStore
    }

    // Remote is the source of truth; the cache is a fallback consulted only when
    // the network call actually failed. An empty cache rethrows that error rather
    // than reporting an empty screen as a success.
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model] {
        do {
            let request = requestBuilder.request(path: "__FEATURE_LOWER__")
            let items = try await apiClient.send(request, decodingTo: [__FEATURE__Model].self)
            try await localStore.cache__FEATURE__List(items)
            return items
        } catch {
            let cached = try await localStore.loadCached__FEATURE__List()
            guard !cached.isEmpty else { throw error }
            return cached
        }
    }
__ELSE_PERSISTENCE__

    init(requestBuilder: RequestBuilder, apiClient: APIClient) {
        self.requestBuilder = requestBuilder
        self.apiClient = apiClient
    }

    func fetch__FEATURE__List() async throws -> [__FEATURE__Model] {
        let request = requestBuilder.request(path: "__FEATURE_LOWER__")
        return try await apiClient.send(request, decodingTo: [__FEATURE__Model].self)
    }
__END_PERSISTENCE__
}

final class __FEATURE__ViewController: UIViewController {
    enum State {
        case idle
        case loading
        case loaded([__FEATURE__Model])
        case error(String)
    }

    private(set) var state: State = .idle {
        didSet { render() }
    }

    private let service: __FEATURE__ServiceProtocol

    private let tableView = UITableView(frame: .zero, style: .plain)
    private let activityIndicator = UIActivityIndicatorView(style: .large)
    private let errorLabel = UILabel()
    private let retryButton = UIButton(type: .system)
    private let errorStack = UIStackView()

    private var items: [__FEATURE__Model] = []

    init(service: __FEATURE__ServiceProtocol) {
        self.service = service
        super.init(nibName: nil, bundle: nil)
    }

    @available(*, unavailable)
    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    override func viewDidLoad() {
        super.viewDidLoad()
        title = L10n.__MODULE_LOWER__.__FEATURE_LOWER__.title
        view.backgroundColor = UIColor(ThemeColor.background)

        setUpTableView()
        setUpActivityIndicator()
        setUpErrorState()
        render()

        Task { await load() }
    }

    // MARK: - Layout

    private func setUpTableView() {
        tableView.dataSource = self
        tableView.delegate = self
        tableView.translatesAutoresizingMaskIntoConstraints = false
        tableView.register(UITableViewCell.self, forCellReuseIdentifier: "__FEATURE_LOWER__.cell")
        view.addSubview(tableView)

        NSLayoutConstraint.activate([
            tableView.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor),
            tableView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
            tableView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
            tableView.bottomAnchor.constraint(equalTo: view.bottomAnchor)
        ])
    }

    private func setUpActivityIndicator() {
        activityIndicator.translatesAutoresizingMaskIntoConstraints = false
        activityIndicator.hidesWhenStopped = true
        view.addSubview(activityIndicator)

        NSLayoutConstraint.activate([
            activityIndicator.centerXAnchor.constraint(equalTo: view.centerXAnchor),
            activityIndicator.centerYAnchor.constraint(equalTo: view.centerYAnchor)
        ])
    }

    private func setUpErrorState() {
        errorLabel.font = UIFont.preferredFont(forTextStyle: .body)
        errorLabel.textColor = UIColor(ThemeColor.secondaryText)
        errorLabel.textAlignment = .center
        errorLabel.numberOfLines = 0

        // "Retry" is generic UI chrome, not feature content — no per-feature L10n
        // key exists for it (new_feature.sh only writes .title/.empty), matching
        // the shared SwiftUI ErrorView's own precedent (app-shell/ErrorView.swift).
        retryButton.setTitle("Retry", for: .normal)
        retryButton.addAction(UIAction { [weak self] _ in
            Task { await self?.load() }
        }, for: .touchUpInside)

        errorStack.axis = .vertical
        errorStack.spacing = 12
        errorStack.alignment = .center
        errorStack.translatesAutoresizingMaskIntoConstraints = false
        errorStack.addArrangedSubview(errorLabel)
        errorStack.addArrangedSubview(retryButton)
        view.addSubview(errorStack)

        NSLayoutConstraint.activate([
            errorStack.centerYAnchor.constraint(equalTo: view.centerYAnchor),
            errorStack.leadingAnchor.constraint(greaterThanOrEqualTo: view.leadingAnchor, constant: 24),
            errorStack.trailingAnchor.constraint(lessThanOrEqualTo: view.trailingAnchor, constant: -24)
        ])
    }

    // MARK: - Loading

    func load() async {
        state = .loading
        do {
            let items = try await service.fetch__FEATURE__List()
            state = .loaded(items)
        } catch {
            state = .error(error.localizedDescription)
        }
    }

    // MARK: - Render

    private func render() {
        switch state {
        case .idle, .loading:
            tableView.isHidden = true
            errorStack.isHidden = true
            activityIndicator.startAnimating()

        case .loaded(let loadedItems):
            items = loadedItems
            tableView.reloadData()
            activityIndicator.stopAnimating()
            errorStack.isHidden = true
            tableView.isHidden = false

        case .error(let message):
            activityIndicator.stopAnimating()
            tableView.isHidden = true
            errorLabel.text = message
            errorStack.isHidden = false
        }
    }
}

// MARK: - UITableViewDataSource

extension __FEATURE__ViewController: UITableViewDataSource {
    func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
        items.count
    }

    func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
        let cell = tableView.dequeueReusableCell(withIdentifier: "__FEATURE_LOWER__.cell", for: indexPath)
        cell.textLabel?.text = String(describing: items[indexPath.row])
        return cell
    }
}

// MARK: - UITableViewDelegate

extension __FEATURE__ViewController: UITableViewDelegate {
    func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
        tableView.deselectRow(at: indexPath, animated: true)
    }
}
