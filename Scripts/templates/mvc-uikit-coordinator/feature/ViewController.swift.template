import UIKit
import SwiftUI
__MODULE_IMPORTS__

/// Loads __FEATURE__ data for the screen below.
protocol __FEATURE__ServiceProtocol {
    /// Returns every __FEATURE__ item to display.
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model]
}
__IF_PERSISTENCE__

/// Reads and writes the locally cached __FEATURE__ list.
protocol __FEATURE__LocalStoreProtocol {
    /// Returns the cached items, or an empty array when nothing is cached.
    func loadCached__FEATURE__List() async throws -> [__FEATURE__Model]
    /// Replaces the cached items with `items`.
    func cache__FEATURE__List(_ items: [__FEATURE__Model]) async throws
}
__END_PERSISTENCE__

/// Concrete data layer for __FEATURE__.
struct __FEATURE__Service: __FEATURE__ServiceProtocol {
__IF_NETWORKING__
    private let requestBuilder: RequestBuilder
    private let apiClient: APIClient
__IF_PERSISTENCE__
    private let localStore: __FEATURE__LocalStoreProtocol

    init(
        requestBuilder: RequestBuilder,
        apiClient: APIClient,
        localStore: __FEATURE__LocalStoreProtocol
    ) {
        self.requestBuilder = requestBuilder
        self.apiClient = apiClient
        self.localStore = localStore
    }

    /// Fetches from the network and caches the result, falling back to the cache
    /// only when the request failed.
    ///
    /// - Throws: the network error when the request fails and the cache is empty —
    ///   an empty screen is not reported as a success.
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model] {
        do {
            let request = requestBuilder.request(path: "__FEATURE_LOWER__")
            let items = try await apiClient.send(request, decodingTo: [__FEATURE__Model].self)
            try await localStore.cache__FEATURE__List(items)
            return items
        } catch {
            let cached = try await localStore.loadCached__FEATURE__List()
            guard !cached.isEmpty else { throw error }
            return cached
        }
    }
__ELSE_PERSISTENCE__

    init(requestBuilder: RequestBuilder, apiClient: APIClient) {
        self.requestBuilder = requestBuilder
        self.apiClient = apiClient
    }

    /// Fetches the __FEATURE__ list from the network.
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model] {
        let request = requestBuilder.request(path: "__FEATURE_LOWER__")
        return try await apiClient.send(request, decodingTo: [__FEATURE__Model].self)
    }
__END_PERSISTENCE__
__ELSE_NETWORKING__
    // TODO(agent): implement this against localStore, per docs/ai/architecture.md.
    //
    // This app has no networking layer, so the local store is the SOURCE OF TRUTH
    // here, not a fallback for a failed request.
    private let localStore: __FEATURE__LocalStoreProtocol

    init(localStore: __FEATURE__LocalStoreProtocol) {
        self.localStore = localStore
    }

    /// Returns the locally stored __FEATURE__ list.
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model] {
        fatalError("TODO(agent): read __FEATURE__ from localStore — see the note above")
    }
__END_NETWORKING__
}

/// Displays the __FEATURE__ list, and its loading, empty and error states.
final class __FEATURE__ViewController: UIViewController {
    /// What the screen is currently showing.
    enum State {
        /// Nothing requested yet.
        case idle
        /// A load is in flight.
        case loading
        /// A load succeeded, with the items it returned.
        case loaded([__FEATURE__Model])
        /// A load failed, with a message to show the user.
        case error(String)
    }

    /// Current state. Assigning re-renders the screen.
    private(set) var state: State = .idle {
        didSet { render() }
    }

    private let service: __FEATURE__ServiceProtocol

    private let tableView = UITableView(frame: .zero, style: .plain)
    private let loadingView = LoadingView()
    private let errorView = ErrorView()
    private let emptyStateView = EmptyStateView()

    private var items: [__FEATURE__Model] = []

    init(service: __FEATURE__ServiceProtocol) {
        self.service = service
        super.init(nibName: nil, bundle: nil)
    }

    @available(*, unavailable)
    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    override func viewDidLoad() {
        super.viewDidLoad()
        title = L10n.__MODULE_LOWER__.__FEATURE_LOWER__.title
        view.backgroundColor = UIColor(ThemeColor.background)

        setUpTableView()
        setUpStateViews()
        render()

        Task { await load() }
    }

    // MARK: - Layout

    /// Adds the list and pins it to the safe area.
    private func setUpTableView() {
        tableView.dataSource = self
        tableView.delegate = self
        tableView.translatesAutoresizingMaskIntoConstraints = false
        tableView.register(UITableViewCell.self, forCellReuseIdentifier: "__FEATURE_LOWER__.cell")
        view.addSubview(tableView)

        NSLayoutConstraint.activate([
            tableView.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor),
            tableView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
            tableView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
            tableView.bottomAnchor.constraint(equalTo: view.bottomAnchor)
        ])
    }

    /// Adds the shared loading, empty and error views, each filling the screen.
    ///
    /// These come from `DesignSystem/Views/` — never rebuild a spinner or an
    /// error label per feature.
    private func setUpStateViews() {
        errorView.configure(message: "", retry: { [weak self] in
            Task { await self?.load() }
        })
        emptyStateView.configure(message: L10n.__MODULE_LOWER__.__FEATURE_LOWER__.empty)

        for stateView in [loadingView, errorView, emptyStateView] as [UIView] {
            stateView.translatesAutoresizingMaskIntoConstraints = false
            stateView.isHidden = true
            view.addSubview(stateView)

            NSLayoutConstraint.activate([
                stateView.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor),
                stateView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
                stateView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
                stateView.bottomAnchor.constraint(equalTo: view.bottomAnchor)
            ])
        }
    }

    // MARK: - Loading

    /// Loads the list and moves the screen through `.loading` to `.loaded`/`.error`.
    func load() async {
        state = .loading
        do {
            let items = try await service.fetch__FEATURE__List()
            state = .loaded(items)
        } catch {
            state = .error(error.localizedDescription)
        }
    }

    // MARK: - Render

    /// Shows exactly one of the list, loading, empty or error views for `state`.
    private func render() {
        switch state {
        case .idle, .loading:
            show(tableView: false, loading: true, empty: false, error: false)

        case .loaded(let loadedItems):
            items = loadedItems
            tableView.reloadData()
            let isEmpty = loadedItems.isEmpty
            show(tableView: !isEmpty, loading: false, empty: isEmpty, error: false)

        case .error(let message):
            errorView.configure(message: message, retry: { [weak self] in
                Task { await self?.load() }
            })
            show(tableView: false, loading: false, empty: false, error: true)
        }
    }

    /// Sets the visibility of all four mutually exclusive states at once.
    private func show(tableView showTable: Bool, loading: Bool, empty: Bool, error: Bool) {
        tableView.isHidden = !showTable
        loadingView.isHidden = !loading
        emptyStateView.isHidden = !empty
        errorView.isHidden = !error
    }
}

// MARK: - UITableViewDataSource

extension __FEATURE__ViewController: UITableViewDataSource {
    func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
        items.count
    }

    func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
        let cell = tableView.dequeueReusableCell(withIdentifier: "__FEATURE_LOWER__.cell", for: indexPath)
        cell.textLabel?.text = String(describing: items[indexPath.row])
        return cell
    }
}

// MARK: - UITableViewDelegate

extension __FEATURE__ViewController: UITableViewDelegate {
    func tableView(_ tableView: UITableView, didSelectRowAt indexPath: IndexPath) {
        tableView.deselectRow(at: indexPath, animated: true)
    }
}
