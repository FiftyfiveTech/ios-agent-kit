import Foundation

// Shared debounce helper for search-as-you-type interactors (§3.7). Any feature
// with a search-as-you-type field wires through this instead of firing a request
// per keystroke.
public actor Debouncer {
    private let delay: Duration
    private var task: Task<Void, Never>?

    public init(delay: Duration = .milliseconds(300)) {
        self.delay = delay
    }

    public func run(_ action: @escaping @Sendable () async -> Void) {
        task?.cancel()
        task = Task {
            try? await Task.sleep(for: delay)
            guard !Task.isCancelled else { return }
            await action()
        }
    }
}
