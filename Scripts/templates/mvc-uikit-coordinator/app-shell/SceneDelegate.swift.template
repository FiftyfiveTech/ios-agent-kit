import UIKit
__MODULE_IMPORTS__

// Composition root. Manual initializer injection (Q9 default) — dependencies are
// constructed here and threaded down, no container.
final class SceneDelegate: UIResponder, UIWindowSceneDelegate {
    var window: UIWindow?
    private var coordinator: AppCoordinator?

__IF_NETWORKING__
    // Base URL comes from Secrets.xcconfig via Info.plist's APIBaseURL key (§8.3) —
    // never a literal here, and never inside a Service. Set the real value in
    // Secrets.xcconfig (gitignored); Secrets.xcconfig.example records the keys.
    private let requestBuilder = RequestBuilder(baseURL: SceneDelegate.apiBaseURL)
    private let apiClient: APIClient = URLSessionAPIClient()
__END_NETWORKING__
__IF_PERSISTENCE__

    // Local persistence (Q4). One container for the whole app, constructed here in
    // the composition root and threaded into AppCoordinator, which injects it into
    // each feature's LocalStore. Rendered only when the project chose a
    // persistence stack (§3.8).
    private let persistence = PersistenceController.shared
__END_PERSISTENCE__

    func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options: UIScene.ConnectionOptions) {
        guard let windowScene = scene as? UIWindowScene else { return }

        let navigationController = UINavigationController()
        let coordinator = AppCoordinator(
            navigationController: navigationController,
            requestBuilder: requestBuilder,
__IF_PERSISTENCE__
            apiClient: apiClient,
            persistence: persistence
__ELSE_PERSISTENCE__
            apiClient: apiClient
__END_PERSISTENCE__
        )
        coordinator.start()
        self.coordinator = coordinator

        let window = UIWindow(windowScene: windowScene)
        window.rootViewController = navigationController
        window.makeKeyAndVisible()
        self.window = window
    }
__IF_NETWORKING__

    // Crashing at launch is the correct behavior here: a missing or malformed base
    // URL means every request in the app is misconfigured, and failing loudly at
    // startup beats a screen of empty states. This is the sanctioned exception to
    // the force-unwrap policy in docs/CODING_STANDARDS.md.
    //
    // This whole block is absent on a `networking: none` project — an offline app
    // has no RequestBuilder to feed, so there is nothing to resolve and nothing to
    // crash about. The rule is "don't render the reader", never "make the read
    // tolerant": a networked app that silently falls back to a default URL is the
    // failure this guard exists to prevent — which is why the checks below get
    // stricter, never softer.
    //
    // Three separate failures, three separate messages, because each one sends you
    // to a different file. The scheme and host checks are load-bearing rather than
    // belt-and-braces: `//` starts a comment in xcconfig, so pasting `https://host`
    // unescaped truncates the value to `https:`, which URL(string:) parses happily
    // with a nil host — and a scheme-less `host.example.com` parses as a relative
    // URL. Both would otherwise reach RequestBuilder and break every request.
    private static var apiBaseURL: URL {
        guard let raw = Bundle.main.object(forInfoDictionaryKey: "APIBaseURL") as? String else {
            preconditionFailure(
                "APIBaseURL is missing from this target's Info.plist. Add "
                + "APIBaseURL = $(API_BASE_URL) to it — see docs/CODING_STANDARDS.md."
            )
        }

        // A blank key and an absent key are indistinguishable here: $(API_BASE_URL)
        // expands to an empty string either way, so don't claim which one it was.
        let trimmed = raw.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !trimmed.isEmpty else {
            preconditionFailure(
                "APIBaseURL resolved to an empty string. Set API_BASE_URL in "
                + "Secrets.xcconfig — it is either blank there or missing entirely. "
                + "Secrets.xcconfig.example records every key the build expects."
            )
        }

        guard let url = URL(string: trimmed), url.scheme != nil, url.host != nil else {
            preconditionFailure(
                "APIBaseURL is not an absolute URL — got \"\(trimmed)\". It needs both "
                + "a scheme and a host. If that value looks truncated, remember `//` "
                + "starts a comment in xcconfig: write https:/$()/host, not https://host."
            )
        }
        return url
    }
__END_NETWORKING__
}
