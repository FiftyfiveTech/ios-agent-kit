import UIKit

/// Full-width loading state: a centered activity indicator.
///
/// Add it to a screen and toggle `isHidden` — it animates whenever it is visible,
/// so a caller never has to pair `startAnimating`/`stopAnimating` with visibility.
public final class LoadingView: UIView {
    private let activityIndicator = UIActivityIndicatorView(style: .large)

    public override init(frame: CGRect) {
        super.init(frame: frame)
        setUp()
    }

    @available(*, unavailable)
    required init?(coder: NSCoder) {
        fatalError("init(coder:) has not been implemented")
    }

    /// Starts or stops the indicator to match this view's visibility.
    public override var isHidden: Bool {
        didSet {
            if isHidden {
                activityIndicator.stopAnimating()
            } else {
                activityIndicator.startAnimating()
            }
        }
    }

    private func setUp() {
        isAccessibilityElement = true
        accessibilityLabel = L10n.__MODULE_LOWER__.common.loading
        accessibilityTraits = .updatesFrequently

        activityIndicator.translatesAutoresizingMaskIntoConstraints = false
        activityIndicator.startAnimating()
        addSubview(activityIndicator)

        NSLayoutConstraint.activate([
            activityIndicator.centerXAnchor.constraint(equalTo: centerXAnchor),
            activityIndicator.centerYAnchor.constraint(equalTo: centerYAnchor)
        ])
    }
}
