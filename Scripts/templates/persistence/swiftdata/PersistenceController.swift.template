import Foundation
import SwiftData

/// The app's SwiftData stack.
///
/// The one place a `ModelContainer` is created. Every feature's local store takes
/// `context` by initializer injection from the composition root — nothing below
/// that root reaches for `.shared`.
public final class PersistenceController {
    /// The app-wide instance, constructed at the composition root.
    public static let shared = PersistenceController()

    /// The container backing every local store.
    public let container: ModelContainer

    /// The main-actor context every LocalStore reads and writes through.
    @MainActor
    public var context: ModelContext { container.mainContext }

    /// - Parameter inMemory: use a throwaway store, for tests and previews.
    public init(inMemory: Bool = false) {
        // One @Model record type per feature. /new-feature inserts each one at the
        // marker below — don't edit the list by hand.
        let schema = Schema([
            // MARK: new-feature-model-insertion-point
        ])
        let configuration = ModelConfiguration(schema: schema, isStoredInMemoryOnly: inMemory)
        do {
            container = try ModelContainer(for: schema, configurations: configuration)
        } catch {
            // A container that can't open is a programmer error (a bad schema, or
            // a migration that was never written), not a runtime condition to
            // recover from — fail loudly at launch rather than silently running
            // without persistence.
            fatalError("SwiftData ModelContainer failed to load: \(error)")
        }
    }
}
