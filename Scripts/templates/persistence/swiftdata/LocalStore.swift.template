import Foundation
import SwiftData
__MODULE_IMPORTS__

/// SwiftData-backed cache for the __FEATURE__ list.
///
/// The protocol it conforms to is declared by its consumer, beside the remote
/// dependency it sits next to; this file is only the implementation. `context`
/// arrives by injection — nothing here reaches for `PersistenceController.shared`.
@MainActor
struct __FEATURE__LocalStore: __FEATURE__LocalStoreProtocol {
    private let context: ModelContext

    init(context: ModelContext) {
        self.context = context
    }

    /// Returns every cached item, or an empty array when nothing is cached.
    func loadCached__FEATURE__List() async throws -> [__FEATURE__Model] {
        try context.fetch(FetchDescriptor<__FEATURE__Record>()).map { $0.asModel() }
    }

    /// Replaces the whole cached list with `items`.
    ///
    /// Replace-all is correct for a whole-list fetch and needs no identity column.
    /// A feature that pages, merges or syncs deltas replaces this with a real
    /// upsert keyed on the record's identifier — see `docs/ai/architecture.md`.
    func cache__FEATURE__List(_ items: [__FEATURE__Model]) async throws {
        try context.delete(model: __FEATURE__Record.self)
        for item in items {
            context.insert(__FEATURE__Record(from: item))
        }
        try context.save()
    }
}
