__IF_PERSISTENCE__
//
// The Worker is also where local persistence enters this pattern: it consumes the
// local store, so it declares its protocol. This half exists only because the
// project answered Q4 with a persistence stack — a `persistence: None` project's
// Worker is remote-only (§3.8).
public protocol __FEATURE__LocalStoreProtocol {
    func loadCached__FEATURE__List() async throws -> [__FEATURE__Model]
    func cache__FEATURE__List(_ items: [__FEATURE__Model]) async throws
}

__END_PERSISTENCE__
public struct __FEATURE__Worker: __FEATURE__WorkerProtocol {
    private let requestBuilder: RequestBuilder
    private let apiClient: APIClient
__IF_PERSISTENCE__
    private let localStore: __FEATURE__LocalStoreProtocol

    public init(
