            guard !cached.isEmpty else { throw error }
            return cached
        }
    }
__ELSE_PERSISTENCE__

    public init(requestBuilder: RequestBuilder, apiClient: APIClient) {
        self.requestBuilder = requestBuilder
        self.apiClient = apiClient
    }

    public func fetch__FEATURE__List() async throws -> [__FEATURE__Model] {
