import Foundation
__MODULE_IMPORTS__

// Presenter imports Foundation only — no UIKit, no Color/Image in its output.
//
// __FEATURE__DisplayLogic is declared here, not in ViewController.swift — a
// protocol is owned by the module that CONSUMES it, never the one that
// implements it (§8.2). This Presenter is the only consumer; the ViewController
// conforms.
public protocol __FEATURE__DisplayLogic: AnyObject {
    func display(viewState: __FEATURE__.Load.ViewState)
    func displayError(message: String)
}

public final class __FEATURE__Presenter: __FEATURE__PresentationLogic {
    // MUST be weak. Interactor holds this Presenter strongly, and this Presenter
    // points back at the ViewController that owns the Interactor in the first
    // place — a strong reference here closes that into a retain cycle
    // (ViewController → Interactor → Presenter → ViewController) and leaks the
    // whole scene every time it's pushed. This is the single most important
    // correctness property in this combo.
    public weak var displayLogic: __FEATURE__DisplayLogic?

    public init() {}

    public func present(response: __FEATURE__.Load.Response) {
        let viewState = __FEATURE__.Load.ViewState(items: response.items)
        // display(viewState:) must land on the main thread — Interactor/Worker
        // do their work off the main actor, so hop explicitly here rather than
        // assuming the caller already did.
        Task { @MainActor [weak self] in
            self?.displayLogic?.display(viewState: viewState)
        }
    }

    public func present(error: Error) {
        let message = error.localizedDescription
        Task { @MainActor [weak self] in
            self?.displayLogic?.displayError(message: message)
        }
    }
}
