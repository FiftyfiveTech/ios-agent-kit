import UIKit
import SwiftUI
__MODULE_IMPORTS__

/// What this scene asks its Interactor to do.
///
/// Declared here rather than beside the Interactor because a protocol is owned by
/// its consumer, and this ViewController is the Interactor's only consumer.
public protocol __FEATURE__BusinessLogic {
    /// Starts a load. Results arrive through `__FEATURE__DisplayLogic`, never as a
    /// return value.
    func load(request: __FEATURE__.Load.Request) async
}

/// Renders the __FEATURE__ scene and forwards user intent to the Interactor.
public final class __FEATURE__ViewController: UIViewController, __FEATURE__DisplayLogic {
    private let interactor: __FEATURE__BusinessLogic

    private let tableView = UITableView(frame: .zero, style: .plain)
    private let loadingView = LoadingView()
    private let errorView = ErrorView()
    private let emptyStateView = EmptyStateView()

    private var items: [__FEATURE__Model] = []

    private static let cellReuseIdentifier = "__FEATURE__Cell"

    public init(interactor: __FEATURE__BusinessLogic) {
        self.interactor = interactor
        super.init(nibName: nil, bundle: nil)
    }

    /// Unavailable: this scene is always composed in code by `AppCoordinator`.
    @available(*, unavailable)
    public required init?(coder: NSCoder) {
        fatalError("init(coder:) is not supported — this scene is composed in code")
    }

    public override func viewDidLoad() {
        super.viewDidLoad()
        navigationItem.title = L10n.__MODULE_LOWER__.__FEATURE_LOWER__.title
        view.backgroundColor = UIColor(ThemeColor.background)
        setUpTableView()
        setUpStateViews()
        dispatchLoad()
    }

    /// Fires the load request and shows the loading state.
    ///
    /// Nothing is read back off the Interactor — the reply arrives through
    /// `display(viewState:)` or `displayError(message:)`.
    private func dispatchLoad() {
        show(tableView: false, loading: true, empty: false, error: false)
        Task { [weak self] in
            guard let self else { return }
            await self.interactor.load(request: __FEATURE__.Load.Request())
        }
    }

    // MARK: - __FEATURE__DisplayLogic

    /// Shows the loaded items, or the empty state when there are none.
    ///
    /// Called on the main actor: the Presenter hops there before calling this,
    /// since the Interactor/Worker chain runs off it.
    public func display(viewState: __FEATURE__.Load.ViewState) {
        items = viewState.items
        tableView.reloadData()
        let isEmpty = items.isEmpty
        show(tableView: !isEmpty, loading: false, empty: isEmpty, error: false)
    }

    /// Shows the error state with a retry that redispatches the same load.
    public func displayError(message: String) {
        errorView.configure(message: message, retry: { [weak self] in
            self?.dispatchLoad()
        })
        show(tableView: false, loading: false, empty: false, error: true)
    }

    // MARK: - Layout

    /// Adds the list and pins it to the safe area.
    private func setUpTableView() {
        tableView.dataSource = self
        tableView.register(UITableViewCell.self, forCellReuseIdentifier: Self.cellReuseIdentifier)
        tableView.translatesAutoresizingMaskIntoConstraints = false
        tableView.isHidden = true
        view.addSubview(tableView)
        NSLayoutConstraint.activate([
            tableView.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor),
            tableView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
            tableView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
            tableView.bottomAnchor.constraint(equalTo: view.bottomAnchor)
        ])
    }

    /// Adds the shared loading, empty and error views, each filling the screen.
    ///
    /// These come from `DesignSystem/SharedViews/` — never rebuild a spinner or an
    /// error label per feature.
    private func setUpStateViews() {
        emptyStateView.configure(message: L10n.__MODULE_LOWER__.__FEATURE_LOWER__.empty)

        for stateView in [loadingView, errorView, emptyStateView] as [UIView] {
            stateView.translatesAutoresizingMaskIntoConstraints = false
            stateView.isHidden = true
            view.addSubview(stateView)
            NSLayoutConstraint.activate([
                stateView.topAnchor.constraint(equalTo: view.safeAreaLayoutGuide.topAnchor),
                stateView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
                stateView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
                stateView.bottomAnchor.constraint(equalTo: view.bottomAnchor)
            ])
        }
    }

    /// Sets the visibility of all four mutually exclusive states at once.
    private func show(tableView showTable: Bool, loading: Bool, empty: Bool, error: Bool) {
        tableView.isHidden = !showTable
        loadingView.isHidden = !loading
        emptyStateView.isHidden = !empty
        errorView.isHidden = !error
    }
}

extension __FEATURE__ViewController: UITableViewDataSource {
    public func tableView(_ tableView: UITableView, numberOfRowsInSection section: Int) -> Int {
        items.count
    }

    public func tableView(_ tableView: UITableView, cellForRowAt indexPath: IndexPath) -> UITableViewCell {
        let cell = tableView.dequeueReusableCell(withIdentifier: Self.cellReuseIdentifier, for: indexPath)
        let item = items[indexPath.row]
        cell.textLabel?.text = String(describing: item)
        return cell
    }
}
