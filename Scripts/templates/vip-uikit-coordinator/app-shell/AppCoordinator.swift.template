import UIKit
__MODULE_IMPORTS__

/// Owns the app's navigation stack and composes each screen's dependencies.
///
/// This is the app's one navigation mechanism. `/new-feature` registers each new
/// screen as a `make<Feature>ViewController()` factory at the marker below; don't
/// edit that by hand. If the app grows a tab bar, each tab gets its own
/// `AppCoordinator` and `UINavigationController` — never one shared instance.
///
/// Not to be confused with a scene's own `<Feature>Router`: that type decides
/// *where* a scene goes next and calls back here to perform the push. This type
/// owns navigation *state*; a scene's Router owns navigation *decisions*.
///
/// `@MainActor` because it owns a `UINavigationController` and builds screens.
@MainActor
public final class AppCoordinator {
    private let navigationController: UINavigationController
    private let requestBuilder: RequestBuilder
    private let apiClient: APIClient
__IF_PERSISTENCE__
    private let persistence: PersistenceController
__END_PERSISTENCE__

    public init(
        navigationController: UINavigationController,
        requestBuilder: RequestBuilder,
__IF_PERSISTENCE__
        apiClient: APIClient,
        persistence: PersistenceController
__ELSE_PERSISTENCE__
        apiClient: APIClient
__END_PERSISTENCE__
    ) {
        self.navigationController = navigationController
        self.requestBuilder = requestBuilder
        self.apiClient = apiClient
__IF_PERSISTENCE__
        self.persistence = persistence
__END_PERSISTENCE__
    }

    /// Installs the root screen. Called once, from the composition root.
    public func start() {
        // MARK: starter-feature-root-screen-insertion-point
        navigationController.setViewControllers(
            [PlaceholderRootViewController()],
            animated: false
        )
    }

    /// Pushes `viewController` onto the stack.
    public func push(_ viewController: UIViewController) {
        navigationController.pushViewController(viewController, animated: true)
    }

    /// Pops the top screen.
    public func pop() {
        navigationController.popViewController(animated: true)
    }

    // MARK: new-feature-factory-insertion-point
}

/// Placeholder root screen, replaced by the starter feature during setup.
private final class PlaceholderRootViewController: UIViewController {}
