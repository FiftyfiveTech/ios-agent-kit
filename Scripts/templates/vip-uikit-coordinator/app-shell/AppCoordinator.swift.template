import UIKit
__MODULE_IMPORTS__

// Composition root AND navigation owner (§3.4) — the ONE navigation mechanism for
// the whole app. /new-feature registers each new screen's composition as a
// make<Feature>ViewController() factory at the marker below — never touch it by
// hand. If the app grows a tab bar, each tab gets its OWN Coordinator/
// UINavigationController — never a single shared one (§3.5).
//
// Don't confuse this with a per-scene VIP `<Feature>Router` (§3.3, §1.4): that
// type decides WHERE a given scene should go next and calls back into this
// Coordinator to perform the actual push. This Coordinator owns navigation
// STATE; a per-scene Router owns navigation DECISIONS.
//
// /start renders this file with no feature baked in, then runs
// `Scripts/new_feature.sh <StarterFeature>` (the same path /new-feature takes) to
// populate the factory, and finally replaces the placeholder root screen below
// with `make<StarterFeature>ViewController()` — the one substitution that isn't
// marker-driven, because there is exactly one root screen, ever.
// @MainActor because it owns a UINavigationController and constructs screens —
// true regardless of Q4, and what lets a feature factory below touch a
// main-actor-isolated persistence context without further annotation.
@MainActor
public final class AppCoordinator {
    private let navigationController: UINavigationController
    private let requestBuilder: RequestBuilder
    private let apiClient: APIClient
__IF_PERSISTENCE__
    private let persistence: PersistenceController
__END_PERSISTENCE__

    public init(
        navigationController: UINavigationController,
        requestBuilder: RequestBuilder,
__IF_PERSISTENCE__
        apiClient: APIClient,
        persistence: PersistenceController
__ELSE_PERSISTENCE__
        apiClient: APIClient
__END_PERSISTENCE__
    ) {
        self.navigationController = navigationController
        self.requestBuilder = requestBuilder
        self.apiClient = apiClient
__IF_PERSISTENCE__
        self.persistence = persistence
__END_PERSISTENCE__
    }

    public func start() {
        // MARK: starter-feature-root-screen-insertion-point
        navigationController.setViewControllers(
            [PlaceholderRootViewController()],
            animated: false
        )
    }

    public func push(_ viewController: UIViewController) {
        navigationController.pushViewController(viewController, animated: true)
    }

    public func pop() {
        navigationController.popViewController(animated: true)
    }

    // MARK: new-feature-factory-insertion-point
}

// Replace with the starter feature's root screen — see /start.
private final class PlaceholderRootViewController: UIViewController {}
