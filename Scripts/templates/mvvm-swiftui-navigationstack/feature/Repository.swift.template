import Foundation
__MODULE_IMPORTS__

/// The remote data source this feature's repository depends on.
///
/// Declared here rather than beside its implementation because a protocol is
/// owned by its consumer.
protocol __FEATURE__ServiceProtocol {
    /// Fetches the __FEATURE__ list from the API.
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model]
}
__IF_PERSISTENCE__

/// The local cache this feature's repository depends on.
protocol __FEATURE__LocalStoreProtocol {
    /// Returns the cached items, or an empty array when nothing is cached.
    func loadCached__FEATURE__List() async throws -> [__FEATURE__Model]
    /// Replaces the cached items with `items`.
    func cache__FEATURE__List(_ items: [__FEATURE__Model]) async throws
}
__END_PERSISTENCE__

/// Supplies __FEATURE__ data to the ViewModel, hiding where it came from.
struct __FEATURE__Repository: __FEATURE__RepositoryProtocol {
    private let service: __FEATURE__ServiceProtocol
__IF_PERSISTENCE__
    private let localStore: __FEATURE__LocalStoreProtocol

    init(service: __FEATURE__ServiceProtocol, localStore: __FEATURE__LocalStoreProtocol) {
        self.service = service
        self.localStore = localStore
    }

    /// Fetches from the network and caches the result, falling back to the cache
    /// only when the request failed.
    ///
    /// - Throws: the network error when the request fails and the cache is empty —
    ///   an empty screen is not reported as a success.
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model] {
        do {
            let items = try await service.fetch__FEATURE__List()
            try await localStore.cache__FEATURE__List(items)
            return items
        } catch {
            let cached = try await localStore.loadCached__FEATURE__List()
            guard !cached.isEmpty else { throw error }
            return cached
        }
    }
__ELSE_PERSISTENCE__

    init(service: __FEATURE__ServiceProtocol) {
        self.service = service
    }

    /// Fetches the __FEATURE__ list from the remote service.
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model] {
        try await service.fetch__FEATURE__List()
    }
__END_PERSISTENCE__
}
