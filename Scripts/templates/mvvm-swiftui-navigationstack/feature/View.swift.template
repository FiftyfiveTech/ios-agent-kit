import SwiftUI
__MODULE_IMPORTS__

/// The __FEATURE__ screen.
///
/// Renders whatever its ViewModel's state says and forwards user intent back to
/// it — it never reaches for networking or persistence itself.
struct __FEATURE__View: View {
    @State private var viewModel: __FEATURE__ViewModel

    init(viewModel: __FEATURE__ViewModel) {
        self.viewModel = viewModel
    }

    var body: some View {
        content
            .task { await viewModel.load() }
            .navigationTitle(L10n.__MODULE_LOWER__.__FEATURE_LOWER__.title)
    }

    /// One branch per ViewModel state, using the shared state views.
    @ViewBuilder
    private var content: some View {
        switch viewModel.state {
        case .idle, .loading:
            LoadingView()
        case .loaded(let items) where items.isEmpty:
            EmptyStateView(message: L10n.__MODULE_LOWER__.__FEATURE_LOWER__.empty)
        case .loaded(let items):
            List(items, id: \.self) { item in
                Text(String(describing: item))
            }
        case .error(let message):
            ErrorView(message: message) {
                Task { await viewModel.load() }
            }
        }
    }
}

