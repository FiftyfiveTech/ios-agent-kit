import Foundation
import Observation
__MODULE_IMPORTS__

/// The data source this feature's ViewModel depends on.
///
/// Declared here rather than beside its implementation because a protocol is
/// owned by its consumer. The ViewModel talks to it directly — there is no
/// separate business-logic layer in between.
protocol __FEATURE__RepositoryProtocol {
    /// Returns every __FEATURE__ item to display.
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model]
}

/// View state for the __FEATURE__ screen.
@Observable
final class __FEATURE__ViewModel {
    /// What the screen should currently render.
    enum State {
        /// Nothing requested yet.
        case idle
        /// A load is in flight.
        case loading
        /// A load succeeded, with the items it returned.
        case loaded([__FEATURE__Model])
        /// A load failed, with a message to show the user.
        case error(String)
    }

    /// The current state. The View renders exactly this.
    private(set) var state: State = .idle

    private let repository: __FEATURE__RepositoryProtocol

    init(repository: __FEATURE__RepositoryProtocol) {
        self.repository = repository
    }

    /// Loads the list, moving through `.loading` to `.loaded` or `.error`.
    func load() async {
        state = .loading
        do {
            let items = try await repository.fetch__FEATURE__List()
            state = .loaded(items)
        } catch {
            state = .error(error.localizedDescription)
        }
    }
}
