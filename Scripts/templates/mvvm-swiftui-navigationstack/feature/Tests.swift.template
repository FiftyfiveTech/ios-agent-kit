import XCTest
__MODULE_IMPORTS__
__TESTABLE_IMPORT__

/// Covers the ViewModel's load path against a fake repository.
final class __FEATURE__ViewModelTests: XCTestCase {
    func test_load_publishesRepositoryResults() async {
        let expected = __FAKE_MODEL_LIST__
        let repository = Fake__FEATURE__Repository(result: .success(expected))
        let viewModel = __FEATURE__ViewModel(repository: repository)

        await viewModel.load()

        guard case .loaded(let items) = viewModel.state else {
            XCTFail("expected .loaded, got \(viewModel.state)")
            return
        }
        XCTAssertEqual(items, expected)
    }

    func test_load_publishesRepositoryFailure() async {
        let repository = Fake__FEATURE__Repository(result: .failure(FakeError.forced))
        let viewModel = __FEATURE__ViewModel(repository: repository)

        await viewModel.load()

        guard case .error = viewModel.state else {
            XCTFail("expected .error, got \(viewModel.state)")
            return
        }
    }
}

private enum FakeError: Error {
    case forced
}

private final class Fake__FEATURE__Repository: __FEATURE__RepositoryProtocol {
    private let result: Result<[__FEATURE__Model], Error>

    init(result: Result<[__FEATURE__Model], Error>) {
        self.result = result
    }

    func fetch__FEATURE__List() async throws -> [__FEATURE__Model] {
        try result.get()
    }
}

__IF_PERSISTENCE__

/// Covers the read-through cache policy: remote wins when it succeeds and is
/// cached, the cache answers when the remote call fails, and an empty cache
/// rethrows the remote error rather than reporting an empty screen as success.
///
/// Delete these only if you replace the policy — a feature that pages or syncs
/// deltas needs its own.
final class __FEATURE__RepositoryReadThroughTests: XCTestCase {
    func test_fetch_returnsRemoteResultAndCachesIt() async throws {
        let expected = __FAKE_MODEL_LIST__
        let localStore = Fake__FEATURE__LocalStore()
        let repository = __FEATURE__Repository(
            service: Fake__FEATURE__Service(result: .success(expected)),
            localStore: localStore
        )

        let items = try await repository.fetch__FEATURE__List()

        XCTAssertEqual(items, expected)
        let cached = await localStore.cached
        XCTAssertEqual(cached, expected)
    }

    func test_fetch_fallsBackToCacheWhenRemoteFails() async throws {
        let expected = __FAKE_MODEL_LIST__
        let repository = __FEATURE__Repository(
            service: Fake__FEATURE__Service(result: .failure(FakeError.forced)),
            localStore: Fake__FEATURE__LocalStore(cached: expected)
        )

        let items = try await repository.fetch__FEATURE__List()

        XCTAssertEqual(items, expected)
    }

    func test_fetch_rethrowsRemoteErrorWhenCacheIsEmpty() async {
        let repository = __FEATURE__Repository(
            service: Fake__FEATURE__Service(result: .failure(FakeError.forced)),
            localStore: Fake__FEATURE__LocalStore()
        )

        do {
            _ = try await repository.fetch__FEATURE__List()
            XCTFail("expected the remote error to propagate")
        } catch {
            XCTAssertTrue(error is FakeError)
        }
    }
}

private struct Fake__FEATURE__Service: __FEATURE__ServiceProtocol {
    let result: Result<[__FEATURE__Model], Error>

    func fetch__FEATURE__List() async throws -> [__FEATURE__Model] {
        try result.get()
    }
}

private actor Fake__FEATURE__LocalStore: __FEATURE__LocalStoreProtocol {
    private(set) var cached: [__FEATURE__Model]

    init(cached: [__FEATURE__Model] = []) {
        self.cached = cached
    }

    func loadCached__FEATURE__List() async throws -> [__FEATURE__Model] {
        cached
    }

    func cache__FEATURE__List(_ items: [__FEATURE__Model]) async throws {
        cached = items
    }
}
__END_PERSISTENCE__
