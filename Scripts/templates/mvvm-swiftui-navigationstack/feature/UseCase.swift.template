import Foundation
__MODULE_IMPORTS__

// __FEATURE__RepositoryProtocol lives here, not in Repository.swift — UseCase is
// its consumer (§8.2). __FEATURE__UseCase (below) is the OTHER conformance to
// __FEATURE__UseCaseProtocol declared in ViewModel.swift.
protocol __FEATURE__RepositoryProtocol {
    func fetch__FEATURE__List() async throws -> [__FEATURE__Model]
}

// Pure Swift — no UI/networking imports. Depends on the Repository's protocol,
// never its implementation (§8.2).
struct __FEATURE__UseCase: __FEATURE__UseCaseProtocol {
    private let repository: __FEATURE__RepositoryProtocol

    init(repository: __FEATURE__RepositoryProtocol) {
        self.repository = repository
    }

    func execute() async throws -> [__FEATURE__Model] {
        try await repository.fetch__FEATURE__List()
    }
}
