import SwiftUI

/// Empty state: what a screen shows when it loaded successfully and found nothing.
public struct EmptyStateView: View {
    /// The message shown to the user, already localized by the caller.
    private let message: String

    public init(message: String) {
        self.message = message
    }

    public var body: some View {
        Text(message)
            .font(ThemeFont.body)
            .foregroundStyle(ThemeColor.secondaryText)
            .padding()
    }
}

